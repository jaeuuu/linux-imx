	lvds-panel {
		compatible = "solics,ec101-1024600w-d025";
		status = "okay";
		// power-supply = <&reg_panel_pwr>;

		port {
			lvds0_in: endpoint {
				remote-endpoint = <&lvds0_out>;
			};
		};
	};

	rotary-encoder {
		compatible = "rotary-encoder";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_rotary_encoder>;
		gpios = <&gpio5 26 GPIO_ACTIVE_LOW>, <&gpio5 27 GPIO_ACTIVE_LOW>;
		linux,axis = <0>;
		rotary-encoder,steps-per-period = <1>;
		rotary-encoder,encoding = "gray";
		rotary-encoder,relative-axis;
		rotary-encoder,push-button;
		pb-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
	};
};

&pwm_leds {
	cpld-osc {
		label = "cpld-oscillator";
		pwms = <&pwm4 0 100000000>;
		max-brightness = <100>;
	};
};

&flexspi {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexspi0>;
	status = "okay";

	flash0: mt25qu256aba@0 {
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		spi-max-frequency = <80000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <4>;
	};
};

&flexcan1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan1>;
	xceiver-supply = <&reg_can1_stby>;
	status = "okay";
};

&flexcan2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan2>;
	xceiver-supply = <&reg_can2_stby>;
	//pinctrl-assert-gpios = <&pca6416 3 GPIO_ACTIVE_HIGH>;
	status = "okay";/* can2 pin conflict with pdm */
};

&dsp {
	status = "okay";
};

&pwm4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pwm4>;
	status = "okay";
};

&aud2htx {
	status = "okay";
};

&ecspi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	fsl,spi-num-chipselects = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi2 &pinctrl_ecspi2_cs>;
	cs-gpios = <&gpio5 13 GPIO_ACTIVE_LOW>;
	status = "okay";

    sc16is762: sc16is762@0 {
        compatible = "nxp,sc16is762";
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_sc16is762>;
        reg = <0>;
        clock-frequency = <1843200>;
        interrupt-parent = <&gpio3>;
        interrupts = <21 IRQ_TYPE_LEVEL_LOW>;
        reset-gpios = <&gpio4 20 GPIO_ACTIVE_LOW>;
        gpio-controller;
        #gpio-cells = <2>;
    };

	// gpiom1: gpio@0 {
	// 	reg = <0>;
	// 	compatible = "microchip,mcp23s17";
	// 	pinctrl-names = "default";
	// 	pinctrl-0 = <&pinctrl_mcp23s17>;
	// 	gpio-controller;
	// 	#gpio-cells = <2>;
	// 	/* for h/w address pin a2, a1, a0
