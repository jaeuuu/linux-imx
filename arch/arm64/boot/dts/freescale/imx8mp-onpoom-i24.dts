	pinctrl_usb1_vbus: usb1grp {
		fsl,pins = <
			MX8MP_IOMUXC_GPIO1_IO12__GPIO1_IO12		0x10
		>;
	};

	pinctrl_usdhc2: usdhc2grp {
		fsl,pins = <
			MX8MP_IOMUXC_SD2_CLK__USDHC2_CLK	0x190
			MX8MP_IOMUXC_SD2_CMD__USDHC2_CMD	0x1d0
			MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0	0x1d0
			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1	0x1d0
			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2	0x1d0
			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3	0x1d0
			MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT	0xc0
		>;
	};

	pinctrl_usdhc2_100mhz: usdhc2-100mhzgrp {
		fsl,pins = <
			MX8MP_IOMUXC_SD2_CLK__USDHC2_CLK	0x194
			MX8MP_IOMUXC_SD2_CMD__USDHC2_CMD	0x1d4
			MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0	0x1d4
			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1	0x1d4
			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2	0x1d4
			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3	0x1d4
			MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT 0xc0
		>;
	};

	pinctrl_usdhc2_200mhz: usdhc2-200mhzgrp {
		fsl,pins = <
			MX8MP_IOMUXC_SD2_CLK__USDHC2_CLK	0x196
			MX8MP_IOMUXC_SD2_CMD__USDHC2_CMD	0x1d6
			MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0	0x1d6
			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1	0x1d6
			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2	0x1d6
			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3	0x1d6
			MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT 0xc0
		>;
	};

	pinctrl_usdhc2_gpio: usdhc2gpiogrp {
		fsl,pins = <
			MX8MP_IOMUXC_SD2_CD_B__GPIO2_IO12	0x1c4
		>;
	};

	pinctrl_reg_usdhc2_vmmc: regusdhc2vmmcgrp {
		fsl,pins = <
			MX8MP_IOMUXC_SD2_RESET_B__GPIO2_IO19	0x40
		>;
	};

	pinctrl_ts: tsgrp {
		fsl,pins = <
            MX8MP_IOMUXC_GPIO1_IO05__GPIO1_IO05     0x10
            MX8MP_IOMUXC_SD1_DATA2__GPIO2_IO04      0x10
		>;
	};

	pinctrl_rotary_encoder: rotaryencodergrp {
		fsl,pins = <
			MX8MP_IOMUXC_UART3_RXD__GPIO5_IO26		0x10	/* CLK_A_ROTARY */
			MX8MP_IOMUXC_UART3_TXD__GPIO5_IO27		0x10	/* CLK_B_ROTARY */
			MX8MP_IOMUXC_GPIO1_IO11__GPIO1_IO11		0x10	/* nPUSH_ROTARY */
		>;
	};

	/* MCU channel */
	pinctrl_mcp23017_0: mcp23017-0grp {
		fsl,pins = <
			MX8MP_IOMUXC_GPIO1_IO08__GPIO1_IO08		0x10	/* I2C_IO_INT */
			MX8MP_IOMUXC_GPIO1_IO07__GPIO1_IO07		0x10	/* I2C_IO_RST */
		>;
	};

	/* SAT channel */
	pinctrl_mcp23017_1: mcp23017-1grp {
		fsl,pins = <
			MX8MP_IOMUXC_SD1_STROBE__GPIO2_IO11		0x10	/* SAT_I2C_nINT */
			MX8MP_IOMUXC_SD1_DATA3__GPIO2_IO05		0x10	/* SAT_I2C_nRST */
		>;
	};

	/* PMU channel */
	pinctrl_mcp23017_2: mcp23017-2grp {
		fsl,pins = <
			MX8MP_IOMUXC_SD1_RESET_B__GPIO2_IO10	0x10	/* PMU_I2C_nINT */
			MX8MP_IOMUXC_SD1_DATA4__GPIO2_IO06		0x10	/* PMU_I2C_nRST */
		>;
	};

	/* FCU channel */
	pinctrl_mcp23017_3: mcp23017-3grp {
		fsl,pins = <
			MX8MP_IOMUXC_SD1_CLK__GPIO2_IO00		0x10	/* FCU_I2C_nINT */
			MX8MP_IOMUXC_SD1_DATA5__GPIO2_IO07		0x10	/* FCU_I2C_nRST */
		>;
	};

	/* WTI channel */
	pinctrl_mcp23017_5: mcp23017-5grp {
		fsl,pins = <
			MX8MP_IOMUXC_SD1_CMD__GPIO2_IO01		0x10	/* WTI_I2C_nINT */
			MX8MP_IOMUXC_SD1_DATA6__GPIO2_IO08		0x10	/* WTI_I2C_nRST */
		>;
	};

	/* WVU channel */
	pinctrl_mcp23017_6: mcp23017-6grp {
		fsl,pins = <
			MX8MP_IOMUXC_SD1_DATA0__GPIO2_IO02		0x10	/* WVU_I2C_nINT */
			MX8MP_IOMUXC_SD1_DATA7__GPIO2_IO09		0x10	/* WVU_I2C_nRST */
		>;
	};

	/* APU channel */
	pinctrl_mcp23017_7: mcp23017-7grp {
		fsl,pins = <
			MX8MP_IOMUXC_SD1_DATA1__GPIO2_IO03		0x10	/* APU_I2C_nINT */
			MX8MP_IOMUXC_GPIO1_IO06__GPIO1_IO06		0x10	/* APU_I2C_nRST */
		>;
	};

    pinctrl_sc16is762: sc16is762grp {
        fsl,pins = <
            MX8MP_IOMUXC_SAI5_RXD0__GPIO3_IO21      0x80    /* SPI_INT */
            MX8MP_IOMUXC_SAI1_MCLK__GPIO4_IO20      0x80    /* SPI_RST */
        >;
    };
};

